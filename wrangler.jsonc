{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webcombo-studio",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "WebComboContainer",
      "image": "./Dockerfile",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WebComboContainer",
        "name": "WEBCOMBO",
      },
    ],
  },
  "exports": {
    "WebComboContainer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
  },
}
